# LLM Feature Store Configuration
# Copy this file to .env and customize for your environment

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
ENVIRONMENT=local  # local, development, staging, production
DEBUG=true

# ==============================================================================
# KAFKA
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_INTERACTIONS=llm-interactions
KAFKA_TOPIC_EMBEDDINGS=embedding-requests
KAFKA_CONSUMER_GROUP=feature-store-consumers

# ==============================================================================
# REDIS (Caching)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
EMBEDDING_CACHE_TTL=86400  # 24 hours
FEATURE_CACHE_TTL=300      # 5 minutes

# ==============================================================================
# DUCKDB (Analytics)
# ==============================================================================
DUCKDB_PATH=data/feature_store.duckdb
DUCKDB_MEMORY_LIMIT=1GB

# ==============================================================================
# DELTA LAKE (Historical Storage)
# ==============================================================================
DELTA_LAKE_PATH=s3://feature-store/delta-lake
USE_LOCAL_S3=true  # Use MinIO for local development

# MinIO (local S3 replacement)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ==============================================================================
# AWS (Production)
# ==============================================================================
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-here

# DynamoDB
DYNAMODB_TABLE_NAME=llm-features
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST

# ==============================================================================
# EMBEDDING MODEL
# ==============================================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2  # Free local model!
EMBEDDING_MODEL_DEVICE=cpu        # cpu or cuda
EMBEDDING_BATCH_SIZE=32

# OpenAI (optional, costs money!)
USE_OPENAI_EMBEDDINGS=false
# OPENAI_API_KEY=sk-your-key-here

# ==============================================================================
# TEMPORAL (Workflow Orchestration)
# ==============================================================================
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=feature-store-tasks

# ==============================================================================
# OPENFAAS (Serverless Functions)
# ==============================================================================
OPENFAAS_GATEWAY=http://localhost:8083

# ==============================================================================
# DRIFT DETECTION
# ==============================================================================
DRIFT_DETECTION_WINDOW_DAYS=7
DRIFT_DETECTION_THRESHOLD=0.1     # PSI threshold
DRIFT_CHECK_INTERVAL_HOURS=6

# ==============================================================================
# MONITORING & ALERTING
# ==============================================================================
PROMETHEUS_PORT=9090

# Slack
ENABLE_SLACK_ALERTS=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty
ENABLE_PAGERDUTY_ALERTS=false
# PAGERDUTY_API_KEY=your-key-here

# ==============================================================================
# COST TRACKING
# ==============================================================================
ENABLE_COST_TRACKING=true

# Model pricing (USD per 1K tokens)
# Update these based on current pricing!
COST_PER_1K_INPUT_TOKENS='{"gpt-4": 0.03, "gpt-3.5-turbo": 0.0015, "claude-3-sonnet": 0.003}'
COST_PER_1K_OUTPUT_TOKENS='{"gpt-4": 0.06, "gpt-3.5-turbo": 0.002, "claude-3-sonnet": 0.015}'
